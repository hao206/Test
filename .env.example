# PostgreSQL connection string (Render cấp khi tạo PostgreSQL database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret - đặt chuỗi ngẫu nhiên, khó đoán
JWT_SECRET=campusforge-change-this-secret

# Server port (Render tự set PORT, để local dùng 4000)
PORT=4000

NODE_ENV=production
